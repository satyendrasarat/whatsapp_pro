    "express": "^4.21.2",
    "libphonenumber-js": "^1.11.19",
    "lucide-react": "^1.16.0",
    "p-queue": "^8.1.0",
    "papaparse": "^5.5.2",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5"
  },
