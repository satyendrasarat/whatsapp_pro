{
  "name": "whatsapp-crm-automation",
  "version": "1.0.0",
  "description": "WhatsApp Automation & CRM Desktop Platform with Baileys, SQLite, Visual Flow Builder, and AI Agent",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "dev:all": "concurrently \"npm run server\" \"vite\"",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run server\" \"vite\" \"wait-on tcp:5173 && wait-on tcp:3001 && electron .\"",
    "start": "node server/index.js"
  },
